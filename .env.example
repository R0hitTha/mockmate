# ==============================================================================
# MOCKMATE — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env (or .env.local) and replace the placeholder values.
# NEVER commit real credentials or .env to version control.
# ==============================================================================

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (Neon PostgreSQL)
# For local dev or Neon pooled / direct connections:
# Example: postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/mockmate?sslmode=require
DATABASE_URL="postgresql://mockmate_user:mockmate_password@localhost:5432/mockmate_db?schema=public"

