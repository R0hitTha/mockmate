# ==============================================================================
# MOCKMATE — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env (or .env.local) and replace the placeholder values.
# NEVER commit real credentials or .env to version control.
# ==============================================================================

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (Neon PostgreSQL)
# For local dev or Neon pooled / direct connections:
# Example: postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/mockmate?sslmode=require
DATABASE_URL="postgresql://mockmate_user:mockmate_password@localhost:5432/mockmate_db?schema=public"

# ------------------------------------------------------------------------------
# Phase 4 (Authentication & Student Onboarding - Better Auth)
# ------------------------------------------------------------------------------
# Secret key used for signing cookies and session tokens.
# Generate with: openssl rand -base64 32 or npx better-auth secret
BETTER_AUTH_SECRET="mockmate-dev-auth-secret-key-32-chars-minimum-prod-replace"

# Base URL of your Better Auth server (matches NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth Credentials (Optional - configure to enable Google Single Sign-On)
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# Future Phase Placeholders (Do not activate until relevant phase)
# ------------------------------------------------------------------------------
# Phase 14-15 (Storage & Email Verification / Notifications)
# CLOUDFLARE_R2_ACCOUNT_ID=""
# CLOUDFLARE_R2_ACCESS_KEY_ID=""
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
# CLOUDFLARE_R2_BUCKET=""
# RESEND_API_KEY=""
