# ==============================================================================
# MOCKMATE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env (or .env.local) and replace the placeholder values.
# NEVER commit real credentials or .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT (Required)
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase) (Required)
# ------------------------------------------------------------------------------
# Standard pooled or direct connection string:
# Example (Neon): postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/mockmate?sslmode=require
DATABASE_URL="postgresql://mockmate_user:mockmate_password@localhost:5432/mockmate_db?schema=public"

# Optional direct connection string for Prisma migrations when using connection poolers (PgBouncer/Neon pooled):
# DIRECT_URL="postgresql://mockmate_user:mockmate_password@localhost:5432/mockmate_db?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Better Auth) (Required)
# ------------------------------------------------------------------------------
# Minimum 32-character secret key used for signing cookies and session tokens.
# Generate in terminal: openssl rand -base64 32
BETTER_AUTH_SECRET="mockmate-dev-auth-secret-key-32-chars-minimum-prod-replace"

# Base URL of Better Auth endpoints (must match public application domain in production)
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH CREDENTIALS (Optional - Single Sign-On)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Production redirect URI: https://yourdomain.com/api/auth/callback/google
# Development redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 5. AI STUDY ASSISTANT PROVIDER (Optional - Phase 13)
# ------------------------------------------------------------------------------
# Configure either Gemini or OpenAI API key to enable live AI explanations.
# If omitted, MockMate gracefully displays a setup notice while keeping the
# rule-based study planner and all mock test evaluations 100% operational.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# 6. MONETIZATION & PAYMENT GATEWAY (Optional - Phase 14)
# ------------------------------------------------------------------------------
# Razorpay API credentials for moving from Preparation Mode to live billing.
# If omitted, MockMate safely operates in Preparation Mode with zero live charges.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
