// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

// -----------------------------------------------------------------------------
// Better Auth Core Models
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String?   @default("STUDENT")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  studentProfile StudentProfile?

  questionsCreated Question[]       @relation("QuestionCreatedBy")
  questionsUpdated Question[]       @relation("QuestionUpdatedBy")
  questionReviews  QuestionReview[]

  mockTestsCreated MockTest[]       @relation("MockTestCreatedBy")
  mockTestsUpdated MockTest[]       @relation("MockTestUpdatedBy")
  testAttempts     TestAttempt[]
  testResults      TestResult[]

  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// -----------------------------------------------------------------------------
// MockMate Student Profile & Onboarding Models
// -----------------------------------------------------------------------------

model StudentProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  normalizedPhone     String?
  phoneVerified       Boolean  @default(false)
  academicStatus      String?  // CLASS_12_APPEARING, CLASS_12_PASSED, DROPPER
  stream              String?  // SCIENCE, COMMERCE, HUMANITIES, OTHER
  targetExamYear      Int?     // 2026, 2027, etc.
  onboardingCompleted Boolean  @default(false)
  currentStep         Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subjectPreferences    StudentSubjectPreference[]
  universityPreferences StudentUniversityPreference[]
  studentSubjects       StudentSubject[]

  @@index([normalizedPhone])
  @@map("student_profile")
}

model StudentSubjectPreference {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subjectCode      String
  subjectName      String
  category         String         // LANGUAGE, DOMAIN, GENERAL_TEST
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentProfileId, subjectCode])
  @@index([studentProfileId])
  @@map("student_subject_preference")
}

model StudentUniversityPreference {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  universityCode   String
  universityName   String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentProfileId, universityCode])
  @@index([studentProfileId])
  @@map("student_university_preference")
}

// -----------------------------------------------------------------------------
// Phase 6: CUET Subject & Syllabus Management Models
// -----------------------------------------------------------------------------

model ExamYear {
  id        String   @id @default(cuid())
  year      Int      @unique // 2026, 2027
  name      String   // "CUET UG 2026"
  status    String   @default("ACTIVE") // ACTIVE, UPCOMING, ARCHIVED
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syllabusVersions SyllabusVersion[]
  studentSubjects  StudentSubject[]
  questions        Question[]
  mockTests        MockTest[]

  @@map("exam_year")
}

model SubjectCategory {
  id          String   @id @default(cuid())
  name        String   // "Languages", "Domain Subjects", "General Aptitude Test"
  slug        String   @unique // "languages", "domain-subjects", "general-test"
  code        String   // "SECTION_1", "SECTION_2", "SECTION_3"
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects Subject[]

  @@map("subject_category")
}

model Subject {
  id          String          @id @default(cuid())
  name        String          // "Physics", "Chemistry", "Mathematics", "English", etc.
  slug        String          @unique // "physics", "chemistry", "mathematics"
  code        String          // "314", "306", "101", "501"
  categoryId  String
  category    SubjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  description String?
  icon        String?
  status      String          @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  syllabusVersions SyllabusVersion[]
  studentSubjects  StudentSubject[]
  questions        Question[]
  questionPassages QuestionPassage[]
  mockTestSections MockTestSection[]

  @@index([categoryId])
  @@index([code])
  @@map("subject")
}

model SyllabusVersion {
  id            String    @id @default(cuid())
  subjectId     String
  subject       Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examYearId    String
  examYear      ExamYear  @relation(fields: [examYearId], references: [id], onDelete: Cascade)
  version       String    @default("1.0")
  status        String    @default("PUBLISHED") // DRAFT, REVIEW, PUBLISHED, ARCHIVED
  sourceName    String    // e.g. "NTA CUET UG Official Bulletin & NCERT Class 12"
  sourceUrl     String?   // e.g. "https://exams.nta.ac.in/CUET-UG/"
  verifiedAt    DateTime?
  effectiveDate DateTime?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  units     SyllabusUnit[]
  questions Question[]

  @@unique([subjectId, examYearId, version])
  @@index([subjectId])
  @@index([examYearId])
  @@index([status])
  @@map("syllabus_version")
}

model SyllabusUnit {
  id                String          @id @default(cuid())
  syllabusVersionId String
  syllabusVersion   SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Cascade)
  unitNumber        Int
  title             String
  description       String?
  order             Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  topics    SyllabusTopic[]
  questions Question[]

  @@index([syllabusVersionId])
  @@map("syllabus_unit")
}

model SyllabusTopic {
  id          String       @id @default(cuid())
  unitId      String
  unit        SyllabusUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subtopics SyllabusSubtopic[]
  questions Question[]

  @@index([unitId])
  @@map("syllabus_topic")
}

model SyllabusSubtopic {
  id          String        @id @default(cuid())
  topicId     String
  topic       SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  questions   Question[]

  @@index([topicId])
  @@map("syllabus_subtopic")
}

model StudentSubject {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examYearId       String
  examYear         ExamYear       @relation(fields: [examYearId], references: [id], onDelete: Cascade)
  selectedAt       DateTime       @default(now())

  @@unique([studentProfileId, subjectId, examYearId])
  @@index([studentProfileId])
  @@index([subjectId])
  @@index([examYearId])
  @@map("student_subject")
}

// -----------------------------------------------------------------------------
// Phase 7: CUET Question Bank Management Models
// -----------------------------------------------------------------------------

model QuestionPassage {
  id          String     @id @default(cuid())
  title       String
  passageText String     @db.Text
  subjectId   String?
  subject     Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions   Question[]

  @@index([subjectId])
  @@map("question_passage")
}

model Question {
  id                String             @id @default(cuid())
  questionCode      String             @unique // e.g. "Q-PHY-2026-001"
  examYearId        String
  examYear          ExamYear           @relation(fields: [examYearId], references: [id], onDelete: Restrict)
  subjectId         String
  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  syllabusVersionId String?
  syllabusVersion   SyllabusVersion?   @relation(fields: [syllabusVersionId], references: [id], onDelete: SetNull)
  unitId            String?
  unit              SyllabusUnit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  topicId           String?
  topic             SyllabusTopic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subtopicId        String?
  subtopic          SyllabusSubtopic?  @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  passageId         String?
  passage           QuestionPassage?   @relation(fields: [passageId], references: [id], onDelete: SetNull)
  questionType      String             @default("MCQ_SINGLE") // MCQ_SINGLE, MCQ_MULTIPLE, ASSERTION_REASON, PASSAGE_BASED, TRUE_FALSE
  questionText      String             @db.Text
  difficulty        String             @default("MEDIUM") // EASY, MEDIUM, HARD
  explanation       String?            @db.Text
  marks             Float              @default(5.0) // NTA CUET standard is +5
  negativeMarks     Float              @default(1.0) // NTA CUET standard is -1
  status            String             @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, PUBLISHED, REJECTED, ARCHIVED
  usageCount        Int                @default(0) // Tracks usage in tests/attempts to prevent destructive edits
  createdById       String?
  createdBy         User?              @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?
  updatedBy         User?              @relation("QuestionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  publishedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  options           QuestionOption[]
  reviews           QuestionReview[]
  tags              QuestionTagRelation[]
  mockTestQuestions MockTestQuestion[]
  attemptAnswers    AttemptAnswer[]

  @@index([subjectId])
  @@index([examYearId])
  @@index([status])
  @@index([difficulty])
  @@index([questionType])
  @@map("question")
}

model QuestionOption {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionLabel String   // "A", "B", "C", "D"
  optionText  String   @db.Text
  isCorrect   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([questionId])
  @@map("question_option")
}

model QuestionTag {
  id        String                @id @default(cuid())
  name      String                @unique // e.g. "NCERT Exemplar", "PYQ 2024", "High Yield"
  slug      String                @unique
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  questions QuestionTagRelation[]

  @@map("question_tag")
}

model QuestionTagRelation {
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tagId      String
  tag        QuestionTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([questionId])
  @@index([tagId])
  @@map("question_tag_relation")
}

model QuestionReview {
  id           String    @id @default(cuid())
  questionId   String
  question     Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewerId   String?
  reviewer     User?     @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewStatus String    // APPROVED, REJECTED, CHANGES_REQUESTED
  feedback     String?   @db.Text
  reviewedAt   DateTime  @default(now())

  @@index([questionId])
  @@map("question_review")
}

// -----------------------------------------------------------------------------
// Phase 8: Mock Test Library & Test Builder Models
// -----------------------------------------------------------------------------

model MockTest {
  id                String            @id @default(cuid())
  title             String            // e.g. "CUET UG Physics Full Mock Test 01"
  slug              String            @unique // e.g. "cuet-ug-physics-mock-01"
  testCode          String            @unique // e.g. "MT-CUET-PHY-2026-01"
  description       String?           @db.Text
  examYearId        String
  examYear          ExamYear          @relation(fields: [examYearId], references: [id], onDelete: Restrict)
  testType          String            @default("SUBJECT_WISE") // FULL_LENGTH, SUBJECT_WISE, GENERAL_TEST, SECTIONAL, CUSTOM_PRACTICE
  status            String            @default("DRAFT") // DRAFT, IN_REVIEW, PUBLISHED, ARCHIVED
  difficulty        String            @default("MEDIUM") // EASY, MEDIUM, HARD
  instructions      String?           @db.Text
  totalDuration     Int               @default(45) // In minutes (e.g. 45 or 60)
  totalMarks        Float             @default(200.0) // e.g. 40 * 5 = 200
  totalQuestions    Int               @default(50) // Total questions in test (e.g. 50 with 40 to attempt)
  isOfficialPattern Boolean           @default(false)
  attemptsCount     Int               @default(0) // Safeguard against editing tests with existing student attempts
  createdById       String?
  createdBy         User?             @relation("MockTestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?
  updatedBy         User?             @relation("MockTestUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  sections          MockTestSection[]
  attempts          TestAttempt[]
  testResults       TestResult[]

  @@index([examYearId])
  @@index([status])
  @@index([testType])
  @@index([difficulty])
  @@map("mock_test")
}

model MockTestSection {
  id                 String             @id @default(cuid())
  mockTestId         String
  mockTest           MockTest           @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  title              String             // e.g. "Section A: Compulsory Core"
  subjectId          String
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  sectionType        String             @default("COMPULSORY") // COMPULSORY, OPTIONAL
  description        String?
  order              Int                @default(1)
  duration           Int?               // Optional section-specific duration in minutes
  totalMarks         Float              @default(200.0)
  totalQuestions     Int                @default(50)
  questionsToAttempt Int                @default(40) // NTA pattern allows 40 out of 50
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  questions          MockTestQuestion[]

  @@index([mockTestId])
  @@index([subjectId])
  @@map("mock_test_section")
}

model MockTestQuestion {
  id             String          @id @default(cuid())
  sectionId      String
  section        MockTestSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionNumber Int             // Sequential display number (1, 2, 3...)
  marks          Float           @default(5.0)
  negativeMarks  Float           @default(1.0)
  order          Int             @default(1)
  createdAt      DateTime        @default(now())

  @@unique([sectionId, questionId])
  @@index([sectionId])
  @@index([questionId])
  @@map("mock_test_question")
}

// -----------------------------------------------------------------------------
// Phase 9: CBT Examination Engine Models
// -----------------------------------------------------------------------------

model TestAttempt {
  id             String          @id @default(cuid())
  studentId      String
  student        User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mockTestId     String
  mockTest       MockTest        @relation(fields: [mockTestId], references: [id], onDelete: Restrict)
  status         String          @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, AUTO_SUBMITTED, EXPIRED, CANCELLED
  startedAt      DateTime        @default(now())
  expiresAt      DateTime
  submittedAt    DateTime?
  timeTaken      Int?            // Duration spent in seconds
  totalQuestions Int             @default(0)
  attemptNumber  Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  answers        AttemptAnswer[]
  events         AttemptEvent[]
  result         TestResult?

  @@index([studentId])
  @@index([mockTestId])
  @@index([status])
  @@index([expiresAt])
  @@map("test_attempt")
}

model AttemptAnswer {
  id                 String      @id @default(cuid())
  attemptId          String
  attempt            TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId         String
  question           Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOptionId   String?
  selectedOptionIds  String[]    @default([])
  answerPayload      String?     @db.Text
  answerStatus       String      @default("NOT_VISITED") // NOT_VISITED, NOT_ANSWERED, ANSWERED, MARKED_FOR_REVIEW, ANSWERED_AND_MARKED_FOR_REVIEW
  markedForReview    Boolean     @default(false)
  answeredAt         DateTime?
  version            Int         @default(1)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([answerStatus])
  @@map("attempt_answer")
}

model AttemptEvent {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  eventType  String      // ATTEMPT_STARTED, ANSWER_SAVED, ANSWER_CLEARED, MARKED_FOR_REVIEW, SECTION_CHANGED, SUBMITTED, AUTO_SUBMITTED
  payload    String?     @db.Text
  createdAt  DateTime    @default(now())

  @@index([attemptId])
  @@index([eventType])
  @@map("attempt_event")
}

// -----------------------------------------------------------------------------
// Phase 10: Evaluation & Result System Models
// -----------------------------------------------------------------------------

model TestResult {
  id                 String              @id @default(cuid())
  attemptId          String              @unique
  attempt            TestAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  studentId          String
  student            User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mockTestId         String
  mockTest           MockTest            @relation(fields: [mockTestId], references: [id], onDelete: Restrict)
  testVersionId      String?
  totalMarks         Float               @default(0.0)
  maximumMarks       Float               @default(0.0)
  percentage         Float               @default(0.0)
  accuracy           Float               @default(0.0)
  correctCount       Int                 @default(0)
  incorrectCount     Int                 @default(0)
  unansweredCount    Int                 @default(0)
  totalQuestions     Int                 @default(0)
  timeTaken          Int?                // Time taken in seconds
  status             String              @default("EVALUATED") // PENDING_EVALUATION, EVALUATING, EVALUATED, EVALUATION_FAILED
  evaluatedAt        DateTime?           @default(now())
  evaluationVersion  Int                 @default(1)
  failureReason      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  sections           TestResultSection[]
  questions          TestResultQuestion[]

  @@index([studentId])
  @@index([mockTestId])
  @@index([status])
  @@index([createdAt])
  @@map("test_result")
}

model TestResultSection {
  id                 String     @id @default(cuid())
  resultId           String
  result             TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  sectionId          String
  sectionTitle       String
  subjectId          String
  subjectName        String
  totalMarks         Float      @default(0.0)
  maximumMarks       Float      @default(0.0)
  correctCount       Int        @default(0)
  incorrectCount     Int        @default(0)
  unansweredCount    Int        @default(0)
  totalQuestions     Int        @default(0)
  accuracy           Float      @default(0.0)
  createdAt          DateTime   @default(now())

  @@index([resultId])
  @@index([sectionId])
  @@map("test_result_section")
}

model TestResultQuestion {
  id                   String     @id @default(cuid())
  resultId             String
  result               TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  questionId           String
  questionVersionId    String?
  questionNumber       Int
  sectionId            String
  sectionTitle         String
  questionText         String     @db.Text
  passageText          String?    @db.Text
  questionType         String     @default("MCQ_SINGLE")
  selectedOptionId     String?
  selectedOptionIds    String[]   @default([])
  selectedOptionLabel  String?
  correctOptionId      String?
  correctOptionLabel   String?
  optionsJson          String     @db.Text // Full snapshot of options with id, label, text, isCorrect
  status               String     // CORRECT, INCORRECT, UNANSWERED
  isCorrect            Boolean    @default(false)
  markedForReview      Boolean    @default(false)
  awardedMarks         Float      @default(0.0)
  maximumMarks         Float      @default(5.0)
  negativeMarksApplied Float      @default(0.0)
  explanation          String?    @db.Text
  createdAt            DateTime   @default(now())

  @@index([resultId])
  @@index([questionId])
  @@index([status])
  @@map("test_result_question")
}
